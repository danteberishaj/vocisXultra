# Booking enquiry form — src/app/actions/send-booking.ts
#
# Without RESEND_API_KEY the form renders and validates, but submitting
# returns the error message and logs "[booking] RESEND_API_KEY is not set".
#
# Setup:
#   1. Create an account at https://resend.com using vocisxultra@gmail.com
#   2. Copy an API key into RESEND_API_KEY below
#   3. Add the same variable in Vercel → Project → Settings → Environment Variables
#
# Until a domain is verified in Resend, leave CONTACT_FROM_EMAIL unset: the
# default onboarding@resend.dev only delivers to the address that owns the
# Resend account, which is enough to test. Once vocisxultra.org is verified,
# set it to something like "vocisXultra <bookings@vocisxultra.org>".

RESEND_API_KEY=

# Optional — both have sensible defaults.
# CONTACT_TO_EMAIL=vocisxultra@gmail.com
# CONTACT_FROM_EMAIL=
